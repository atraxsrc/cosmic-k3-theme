# K3 for Ghostty, part of cosmic-k3-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = K3
# or, with the K3 Day half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:K3,light:K3Day

background = #101315
foreground = #CACCCC

cursor-color = #798186
cursor-text = #101315

selection-background = #343D41
selection-foreground = #CACCCC

split-divider-color = #4B4E55
unfocused-split-fill = #101315

# black
