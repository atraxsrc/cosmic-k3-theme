# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#101315"

# Main text color
theme[main_fg]="#A5AEB4"

# Title color for boxes
theme[title]="#798186"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#C9C2B4"

# Background color of selected item in processes box
theme[selected_bg]="#798186"

# Foreground color of selected item in processes box
theme[selected_fg]="#101315"

# Color of inactive/disabled text
theme[inactive_fg]="#4B4E55"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#CACCCC"

# Box outline and divider line color
theme[cpu_box]="#4B4E55"
theme[mem_box]="#4B4E55"
theme[net_box]="#4B4E55"
theme[proc_box]="#4B4E55"
theme[div_line]="#343D41"

# Gradient for all meters and graphs: mist -> khaki -> terracotta
theme[temp_start]="#9FA5A9"
theme[temp_mid]="#C9C2B4"
theme[temp_end]="#DE6145"


theme[cpu_start]="#9FA5A9"
theme[cpu_mid]="#C9C2B4"
theme[cpu_end]="#DE6145"


theme[free_start]="#9FA5A9"
theme[free_mid]="#C9C2B4"
theme[free_end]="#DE6145"


theme[cached_start]="#D87C4A"
theme[cached_mid]="#D87C4A"
theme[cached_end]="#D87C4A"


theme[available_start]="#949494"
theme[available_mid]="#949494"
theme[available_end]="#949494"


theme[used_start]="#DE6145"
theme[used_mid]="#DE6145"
theme[used_end]="#DE6145"


theme[download_start]="#9FA5A9"
theme[download_mid]="#C9C2B4"
theme[download_end]="#DE6145"


theme[upload_start]="#9FA5A9"
theme[upload_mid]="#C9C2B4"
theme[upload_end]="#DE6145"
